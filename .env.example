# Replace this before exposing the service. If left blank, one random shared key
# is generated at startup and printed to the container logs.
API_KEY=

REST_PORT=3000
MCP_PORT=3001
MCP_RATE_LIMIT_PER_SECOND=10
API_RATE_LIMIT_PER_SECOND=10
MCP_MAX_OUTPUT_CHARACTERS=50000
FETCH_TIMEOUT_MS=15000
MAX_DOWNLOAD_BYTES=5242880

# Optional comma-separated public hostnames accepted in Host headers.
# Example: reader.example.com,localhost
MCP_ALLOWED_HOSTS=
